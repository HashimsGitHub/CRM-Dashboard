# Neon PostgreSQL connection string (use the POOLED connection string on Vercel)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Random secret, 32+ chars (openssl rand -base64 48). Used to HMAC session tokens.
SESSION_SECRET=replace-with-a-long-random-string

# First administrator, created by `npm run db:seed` (password is stored hashed)
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=change-me-to-a-strong-password

# Optional: separate database used ONLY by `npm test` (tables are truncated!). Never point at real data.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/crm_test
